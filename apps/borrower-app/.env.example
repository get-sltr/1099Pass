# API base URL (required for production). No trailing slash.
# Production: https://api.1099pass.com (or your API Gateway invoke URL)
# EXPO_PUBLIC_API_URL=https://api.1099pass.com

# Set to "true" to call real API in development instead of mock data.
# Requires EXPO_PUBLIC_API_URL to be set and backend running.
# EXPO_PUBLIC_USE_REAL_API=true
