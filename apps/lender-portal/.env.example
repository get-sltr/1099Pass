# 1099Pass Lender Portal — example env
# Copy to .env.local and fill in values.
# For production S3 deploy: set NEXT_PUBLIC_API_URL and optionally GA when building.

# Google Analytics 4 (optional). Enables page views and events site-wide, including blog.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# API base URL (required for production). Used by the portal to call the backend.
# NEXT_PUBLIC_API_URL=https://api.1099pass.com

# Optional: for Live Rates page when not using backend (e.g. local dev without deployed API).
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_fred_api_key
